# Rotas sem ".php" (Apache / LiteSpeed, ex.: Hostinger). No "php -S", quem faz isso é o router.php.
#   /pote?c=…  → pote.php      /cozinha/frases → cozinha/frases.php      /pote.php?… → redireciona para /pote?…
Options -MultiViews -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# pastas e arquivos internos nunca são servidos (.env, includes, dados, migrations…)
RewriteRule ^(includes|data|database|partials|vendor)(/|$) erro.php [L]
RewriteRule (^|/)\.(?!well-known/) erro.php [L]
RewriteRule ^router\.php$ erro.php [L]
# documentação e dependências não são públicas (o README descreve o painel e as tabelas)
RewriteRule ^(README\.md|composer\.(json|lock))$ erro.php [L]
# fotos e selos enviados nas compras: só imagem (nada de script)
RewriteRule ^uploads/(?!pedidos/[a-f0-9]{24}\.(jpg|png)$) erro.php [L]

# SEO: robots.txt e sitemap.xml gerados pelo PHP; os potes têm endereço fixo (/direita, /esquerda → pote.php)
RewriteRule ^robots\.txt$ robots.php [L]
RewriteRule ^sitemap\.xml$ sitemap.php [L]
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^(direita|esquerda)/$ %1 [R=301,L]
RewriteRule ^(direita|esquerda)$ pote.php?pote=$1 [L,QSA]

# quem pede ".php" vai para a rota sem a extensão (só GET; mantém o ?c=…)
RewriteCond %{REQUEST_METHOD} =GET
RewriteCond %{THE_REQUEST} \s/+([^?\s]*?)(?:index)?\.php[?\s] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# rota sem extensão → arquivo .php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.+?)/?$ $1.php [L]

# o resto (endereço que não existe) → página de erro 404 com botão para a página inicial (erro.php)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ erro.php [L]
</IfModule>

# Segunda barreira (vale mesmo sem mod_rewrite): .env, documentação e composer nunca são entregues
<FilesMatch "^(\.env.*|README\.md|composer\.(json|lock))$">
    Require all denied
</FilesMatch>

# App (PWA): tipo do manifest e o service worker sempre conferido (senão os aparelhos demoram a pegar a versão nova)
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
    <FilesMatch "^(sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
