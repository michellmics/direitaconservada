# Copie para .env e preencha. O .env NÃO vai para o git.

APP_ENV=local
APP_URL=http://localhost:8080

# MySQL 8.0.16+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=direitaconservada
DB_USERNAME=root
DB_PASSWORD=

# Senha do painel /admin/ (deixe vazia para desativar o painel)
ADMIN_PASSWORD=

# E-mail (login por link mágico) — SMTP
ENV_SMTP_HOST=smtp.hostinger.com
ENV_SMTP_PORT=465
ENV_SMTP_USER=
ENV_SMTP_PASS=
# ssl | tls | none — vazio = automático (465 → ssl, outras → tls)
ENV_SMTP_SECURE=
# nome do remetente (opcional)
MAIL_FROM_NAME=
