# Copie para .env e preencha. O .env NÃO vai para o git.

APP_ENV=local
APP_URL=http://localhost:8080

# Chave para criptografar os parâmetros das URLs (?c=…). Obrigatória; trocar invalida links já compartilhados.
# Gere uma: php -r "echo bin2hex(random_bytes(32));"
ENV_KEY=

# MySQL 8.0.16+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=direitaconservada
DB_USERNAME=root
DB_PASSWORD=

# Senha do painel /admin/ (deixe vazia para desativar o painel)
ADMIN_PASSWORD=

# E-mail (login por link mágico) — SMTP
ENV_SMTP_HOST=smtp.hostinger.com
ENV_SMTP_PORT=465
ENV_SMTP_USER=
ENV_SMTP_PASS=
# ssl | tls | none — vazio = automático (465 → ssl, outras → tls)
ENV_SMTP_SECURE=
# 0 = não verifica o certificado do SMTP (antivírus que intercepta e-mail, ex.: Norton).
# Só funciona com APP_ENV=local e APP_URL em localhost; em produção é ignorado.
ENV_SMTP_VERIFICAR=1
# nome do remetente (opcional)
MAIL_FROM_NAME=

# Pix (sem gateway): o código vai direto para esta chave e você confere/aprova em /admin/pedidos
# PIX_CHAVE: e-mail, CPF/CNPJ (só números), celular com +55 (ex.: +5511999999999) ou chave aleatória
PIX_CHAVE=
# nome do recebedor como está no banco (até 25 letras) e cidade (até 15)
PIX_NOME=
PIX_CIDADE=

# Atualizar o sistema pelo painel (/cozinha/atualizar): baixa a branch do GitHub e aplica
DEPLOY_REPO=michellmics/direitaconservada
DEPLOY_BRANCH=main
# repositório privado: token "fine-grained" do GitHub, só deste repositório, com Contents: Read-only
DEPLOY_TOKEN=
